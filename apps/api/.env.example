# Banco próprio do ZapMirror — NÃO é o Supabase do ZapScript
DATABASE_URL="postgresql://user:password@localhost:5432/zapmirror"

JWT_SECRET="troque-por-um-segredo-forte"

PORT=3100

# Evolution API compartilhada (mesmo servidor Vultr do ZapScript,
# 216.238.120.65 / api.zapscript.me) — mas usada como infra de terceiro:
# o ZapMirror só cria e gerencia SUAS PRÓPRIAS instâncias (prefixo
# "zapmirror-"), nunca lê/toca nas instâncias dos usuários do ZapScript.
#
# EVOLUTION_API_URL precisa ser a base da API de gerência da Evolution
# (endpoint tipo POST {url}/instance/create) — confirmar com quem administra
# o servidor Vultr se essa rota está exposta publicamente ou só na rede
# interna do Docker Compose. Se só interna, esta API do ZapMirror não
# consegue chamar a Evolution direto de fora e precisa rodar no mesmo host
# ou atrás de um proxy dedicado.
EVOLUTION_API_URL="https://api.zapscript.me"
EVOLUTION_API_KEY="preencher-com-a-api-key-global-da-evolution"

# Prefixo usado em toda instância/nome criado pelo ZapMirror na Evolution
# compartilhada, para nunca colidir com instâncias do ZapScript
EVOLUTION_INSTANCE_PREFIX="zapmirror-"
