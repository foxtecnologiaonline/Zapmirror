{
  "name": "zapmirror",
  "version": "0.0.1",
  "description": "Espelhamento e controle de Android no Windows via ADB",
  "author": "ZapMirror",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node scripts/build.mjs",
    "dev": "npm run typecheck && npm run bundle && electron dist/main/index.js",
    "build": "npm run typecheck && npm run bundle && electron-builder",
    "fetch-scrcpy-server": "node scripts/fetch-scrcpy-server.mjs"
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@yume-chan/fetch-scrcpy-server": "^1.0.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5"
  },
  "build": {
    "appId": "me.zapscript.zapmirror",
    "productName": "ZapMirror",
    "compression": "maximum",
    "electronLanguages": ["en-US"],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/platform-tools",
        "to": "platform-tools"
      },
      {
        "from": "resources/scrcpy",
        "to": "scrcpy"
      }
    ],
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
